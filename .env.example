PORT=18080
APP_ENV=development
# Go MySQL driver DSN or mysql:// URL with ssl-mode=REQUIRED.
DATABASE_URL=wisppay:replace-me@tcp(mysql-host.example:3306)/wisppay?parseTime=true&tls=true
# Optional path to the Aiven CA certificate when it is not in the system trust store.
DATABASE_CA_CERT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
GEMMA_API_KEY=
GEMMA_MODEL=
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080